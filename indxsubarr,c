/*
GeeksforGeeks - Indexes of Subarray Sum
*/

#include <stdio.h>

void subarraySum(int arr[], int n, int sum)
{
    int start = 0;
    int currentSum = 0;

    for(int end = 0; end < n; end++)
    {
        currentSum += arr[end];

        /* Shrink window if currentSum > sum */
        while(currentSum > sum && start <= end)
        {
            currentSum -= arr[start];
            start++;
        }

        /* Subarray found */
        if(currentSum == sum)
        {
            printf("%d %d", start + 1, end + 1);
            return;
        }
    }

    /* No subarray found */
    printf("-1");
}

int main()
{
    int arr[] = {1, 2, 3, 7, 5};
    int n = 5;
    int sum = 12;

    subarraySum(arr, n, sum);

    return 0;
}
